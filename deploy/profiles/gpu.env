# Ava — GPU profile. vLLM on an NVIDIA GPU.
#
#   cd deploy && cp profiles/gpu.env .env && docker compose up -d
#
# Needs ~16 GB of VRAM for the model below at the default 0.90 memory share, and
# the NVIDIA container toolkit installed (nvidia-smi alone is not enough — the
# daemon needs the `nvidia` runtime; install.sh checks for it).
COMPOSE_PROFILES=gpu

AVA_BACKEND_URL=http://vllm:8002/v1
AVA_BACKEND_ENGINE=vllm
# REQUIRED — Ava ships no default model, so name the one you want served.
# Any Hugging Face repo id vLLM can load, e.g.:
#   AVA_MODEL=Qwen/Qwen3-8B-AWQ
#   AVA_MODEL=nvidia/NVIDIA-Nemotron-Nano-9B-v2-FP8
# See docs/CHOOSE_A_MODEL.md for picking one that fits your card.
AVA_MODEL=

# Optional: pin the COMMIT, not just the repo. Unset, vLLM resolves the model's
# default branch tip on every start, so the weights can change under a box that
# has been serving happily for a month. Use the same value as
# `models.<role>.revision` in ava.yaml, which is what `ava models pull` fetches
# — set one without the other and the pin stops at the download.
AVA_MODEL_REVISION=

# SETTING AVA_MODEL: also resolve its vLLM flags, because a tool-call parser
# that does not match the model returns no tool calls at all, silently:
#   deploy/resolve-model-flags.sh --env <model-id> >> deploy/.env
# deploy/install.sh does this for you, for whatever model you chose. Left unset,
# compose passes no parser flags rather than guessing another family's.
