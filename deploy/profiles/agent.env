# Ava — agent profile. vLLM + the tool-using agent, on one box.
#
#   cd deploy && cp profiles/agent.env .env && docker compose up -d
#
# READ THIS: the agent service mounts the host's Docker socket, which is
# ROOT-EQUIVALENT on the host. That is how it spawns the agent sandbox. Use
# gpu.env if you would rather not grant that.
#
# `agent` alone starts no inference engine, so gpu is listed too. Swap it for
# `cpu` (and the backend settings below) to run the agent against Ollama.
COMPOSE_PROFILES=agent,gpu

AVA_BACKEND_URL=http://vllm:8002/v1
AVA_BACKEND_ENGINE=vllm
# REQUIRED — Ava ships no default model. Name a model vLLM can serve, and run
# `deploy/resolve-model-flags.sh --env <model-id> >> deploy/.env` for its flags.
AVA_MODEL=

# All three are required together. Setting only AVA_AGENT_ENABLED leaves the
# bridge in `direct` mode; leaving AVA_ROUTER_HOST on loopback means the agent
# container cannot reach the router at ava:8010. This trio used to be a manual
# step documented three sections away from the command that needed it.
AVA_AGENT_ENABLED=1
AVA_AGENT_RUNTIME=remote
AVA_ROUTER_HOST=0.0.0.0
