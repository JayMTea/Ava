# Ava — cloud profile. No local model; Ava talks to someone else's API.
#
#   cd deploy && cp profiles/cloud.env .env
#   $EDITOR .env          # <- fill in the three values below
#   docker compose up -d
#
# The three are DELIBERATELY EMPTY. Compose refuses to start until you set them
# and tells you which one is missing — that is better than defaulting to a
# provider you did not choose, or to a local engine this profile never starts.
COMPOSE_PROFILES=cloud

# Your provider's OpenAI-compatible base, INCLUDING /v1. Examples:
#   https://api.openai.com/v1
#   https://api.anthropic.com/v1
#   https://openrouter.ai/api/v1
AVA_BACKEND_URL=
AVA_BACKEND_ENGINE=openai
AVA_MODEL=
# Sent as a Bearer token. Anything you put here is readable by anyone who can
# read this file — `chmod 600 deploy/.env`.
AVA_INFERENCE_KEY=
