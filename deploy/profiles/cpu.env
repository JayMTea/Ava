# Ava — CPU profile. Ollama on the CPU: slow, but it starts on any machine.
# deploy/install.sh selects this for a box with no NVIDIA GPU, and for one whose
# largest GPU has under 16 GB of VRAM.
#
#   cd deploy && cp profiles/cpu.env .env && docker compose up -d
#
# FIRST RUN pulls the model (install.sh does this for you):
#   docker compose exec ollama ollama pull llama3.2
COMPOSE_PROFILES=cpu

AVA_BACKEND_URL=http://ollama:11434/v1
AVA_BACKEND_ENGINE=ollama
AVA_MODEL=llama3.2
