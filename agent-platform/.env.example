# Copy to .env for local development. Never commit .env; in deployments use the
# environment or a secret manager. A provider is enabled only when its variable is set.

# --- model providers (models/providers/*.yaml) ----------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Self-hosted OpenAI-compatible server (vLLM, Ollama, LM Studio). Cleared for restricted data.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=

# Force every model call onto one route, e.g. `test` for the offline mock.
AGENT_ROUTE_OVERRIDE=

# --- tools ------------------------------------------------------------------------
# Read-only database for database.query (reference implementation: SQLite).
DATABASE_URL=

# --- MCP servers (mcp/servers.yaml) ----------------------------------------------
EXAMPLE_MCP_URL=
EXAMPLE_MCP_TOKEN=

# --- observability (observability/tracing.yaml exporter: otlp) -------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
