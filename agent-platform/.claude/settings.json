{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/check.py:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m app.cli validate:*)",
      "Bash(python -m app.cli agents:*)",
      "Bash(python -m evals.run --route test:*)",
      "Bash(python -m ruff check:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}
