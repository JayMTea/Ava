{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy.schema.json",
  "title": "Hard policies (policies/*.yaml). One $def per file.",
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["agents", "tools"],
      "additionalProperties": false,
      "properties": {
        "agents": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "tools": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "reason": {"type": "string"}
      }
    },
    "tool_permissions": {
      "type": "object",
      "required": ["schema_version", "default", "grants"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "default": {"const": "deny", "description": "Deny-by-default is not configurable on purpose."},
        "grants": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "denies": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
      }
    },
    "approvals": {
      "type": "object",
      "required": ["schema_version", "require_approval", "non_interactive"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "require_approval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "side_effects": {"type": "array", "items": {"enum": ["none", "read_external", "local_write", "external_write", "destructive"]}},
            "tools": {"type": "array", "items": {"type": "string"}}
          }
        },
        "auto_approve": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"tools": {"type": "array", "items": {"type": "string"}}}
        },
        "non_interactive": {"enum": ["deny", "allow"]},
        "timeout_s": {"type": "integer", "minimum": 1}
      }
    },
    "data_access": {
      "type": "object",
      "required": ["schema_version", "filesystem"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "filesystem": {
          "type": "object",
          "required": ["read_allow", "read_deny", "write_allow"],
          "additionalProperties": false,
          "properties": {
            "read_allow": {"type": "array", "items": {"type": "string"}},
            "read_deny": {"type": "array", "items": {"type": "string"}},
            "write_allow": {"type": "array", "items": {"type": "string"}},
            "write_deny": {"type": "array", "items": {"type": "string"}}
          }
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": {"enum": ["public", "internal", "confidential", "restricted"]},
            "notes": {"type": "string"}
          }
        }
      }
    },
    "network": {
      "type": "object",
      "required": ["schema_version", "default", "allow_domains"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "default": {"enum": ["deny", "allow"]},
        "allow_domains": {"type": "array", "items": {"type": "string"}},
        "allow_schemes": {"type": "array", "items": {"enum": ["https", "http"]}},
        "deny_private_networks": {"type": "boolean"},
        "max_response_bytes": {"type": "integer", "minimum": 1024}
      }
    },
    "safety": {
      "type": "object",
      "required": ["schema_version", "limits"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_turns": {"type": "integer", "minimum": 1},
            "max_tool_calls": {"type": "integer", "minimum": 0},
            "max_delegation_depth": {"type": "integer", "minimum": 0},
            "max_wall_clock_s": {"type": "integer", "minimum": 1}
          }
        },
        "untrusted_content": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"wrap_tool_output": {"type": "boolean"}}
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "patterns": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "regex"],
                "additionalProperties": false,
                "properties": {"name": {"type": "string"}, "regex": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  }
}
