{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "models.schema.json",
  "title": "Model configuration (models/registry.yaml, routing.yaml, providers/*.yaml)",
  "$defs": {
    "registry": {
      "type": "object",
      "required": ["schema_version", "models"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "models": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["provider", "model"],
            "additionalProperties": false,
            "properties": {
              "provider": {"type": "string"},
              "model": {"type": "string", "minLength": 1},
              "context_window": {"type": "integer"},
              "max_output_tokens": {"type": "integer", "minimum": 256},
              "supports_effort": {"type": "boolean"},
              "default_effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
              "options": {"type": "object"},
              "notes": {"type": "string"}
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "required": ["schema_version", "routes"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "routes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "fallback_on": {
          "type": "array",
          "items": {"enum": ["rate_limit", "overloaded", "server_error", "timeout", "connection", "auth", "bad_request", "other"]}
        }
      }
    },
    "provider": {
      "type": "object",
      "required": ["schema_version", "name", "type", "max_data_classification"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "name": {"type": "string"},
        "type": {"enum": ["anthropic", "openai_compatible", "mock"]},
        "enabled": {"type": "boolean"},
        "enabled_when_env": {"type": "array", "items": {"type": "string"}},
        "api_key_env": {"type": "string"},
        "base_url": {"type": "string"},
        "max_data_classification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "options": {"type": "object"},
        "notes": {"type": "string"}
      }
    }
  }
}
