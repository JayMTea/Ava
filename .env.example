# ── Ava — local secrets & overrides ─────────────────────────────────────────
# Copy this file to `.env` (which is gitignored) and fill in the values you want.
# The run scripts (run.sh, run_bridge.sh) and the ava-bridge systemd service load
# `.env` automatically. NEVER commit the real `.env` — only this example.
#
#   cp .env.example .env  &&  chmod 600 .env  &&  $EDITOR .env

# ── Branding (re-brand the whole app) ───────────────────────────────────────
# Shown in the UI, tab title, login/setup screens, and served at /api/brand.
# AVA_NAME=Ava
# AVA_TAGLINE=your private, self-hosted assistant

# ── Auth (phone bridge) ─────────────────────────────────────────────────────
# Login password. If unset, the FIRST web visit prompts you to create one
# (stored 0600 in data/auth_password). Set it here to pin it ahead of time.
AVA_PASSWORD=
# HMAC key that signs session cookies. If unset, generated to data/.secret (0600).
# Set a strong random value (e.g. `openssl rand -hex 32`) to keep sessions valid
# across restarts and to pin it under your control.
AVA_SECRET=
# Session lifetime (days) and cookie security. Leave COOKIE_SECURE=1 (https).
AVA_SESSION_TTL_DAYS=30
AVA_COOKIE_SECURE=1

# ── Voiceprint gates (optional; only respond to the enrolled voice; 0 disables) ─
AVA_PHONE_THRESHOLD=0.40
SPEAKER_THRESHOLD=0.55

# ── Backend model / voice ───────────────────────────────────────────────────
AVA_URL=http://localhost:8002/v1/chat/completions
AVA_MODEL=nvidia/Nemotron-Open-30B-A3B-Reasoning-FP8
WHISPER_MODEL=small.en
# Optional TTS voice model (voice feature is off by default). Point at your own:
# VOICE=$HOME/.ava/models/en_US-amy-medium.onnx

# ── Agent runtime (Ava IS the agent when a runtime is present) ──────────────
# When no runtime is installed, Ava automatically falls back to direct (tool-less)
# chat against the inference endpoint — so a fresh install still works.
# AVA_AGENT_ENABLED=1
AVA_OC_SANDBOX=my-assistant
AVA_OC_AGENT=main
AVA_OC_SESSION=ava-phone
AVA_OC_THINKING=off
AVA_OC_TIMEOUT=600
# Path to the nemoclaw/openclaw CLI. Auto-resolved from PATH if omitted.
# AVA_NEMOCLAW=/usr/local/bin/nemoclaw

# ── Direct-chat inference (used when no agent runtime) ──────────────────────
# Point straight at any OpenAI-compatible endpoint. Add a key for a cloud provider.
# AVA_ROUTER_CHAT=http://127.0.0.1:8010/v1/chat/completions
# AVA_INFERENCE_KEY=

# ── Code mode (Ava edits her own source via Claude) ─────────────────────────
# Your Anthropic API key. Required for the "Code" toggle in the chat composer
# and for code_change_request. This key is not used for Ava's normal chat brain;
# conversational inference stays on the local open-model model. Get one at https://console.anthropic.com/ .
# Keep this file 0600 — never commit the real value.
ANTHROPIC_API_KEY=

# ── Learning digest email (optional) ────────────────────────────────────────
# Sender mailbox + app password for the daily/weekly digest timers. Leave empty
# to skip email delivery. Defaults to SMTP host smtp.office365.com (Outlook);
# override AVA_SMTP_HOST for Gmail (smtp.gmail.com) etc. The report is sent to
# AVA_REPORT_EMAIL, defaulting to the sender.
OUTLOOK_EMAIL=
OUTLOOK_PASSWORD=
# AVA_REPORT_EMAIL=you@example.com
# AVA_SMTP_HOST=smtp.office365.com

# ── Attribution ─────────────────────────────────────────────────────────────
# Name credited as the approver when you approve a code change in the dashboard.
# AVA_OPERATOR_NAME=Admin

# ── Connected apps (connectors) ──────────────────────────────────────────────
# Ava can monitor & drive your OWN apps via connectors. A connector declares the
# env vars it needs (bearer tokens, base URLs, DB DSNs) and you set them here.
# A fresh install needs none of this — see docs/CONNECTOR_SDK.md to wire an app.
# Example:
#   MYAPP_API_URL=http://127.0.0.1:8000
#   MYAPP_API_TOKEN=
#   # AVA_MYAPP_ROOT=$HOME/projects/myapp   # if Ava may edit its source (approval-gated)

# ── Web access (self-hosted SearXNG + host-side SSRF-guarded reader) ─────────
# Ava's web layer is host-mediated: her sandbox tools call the bridge's
# /internal/web/* routes and the HOST runs search + fetch. Search hits a PRIVATE,
# loopback-only SearXNG container (see searxng/run.sh). Nothing here is exposed
# to the sandbox and no API keys are used.
AVA_WEB_SEARXNG_URL=http://127.0.0.1:8888
AVA_WEB_MAX_RESULTS=8
AVA_WEB_TIMEOUT=15
# Fetch safety caps (bytes read from a page, chars returned to Ava, redirect hops).
AVA_WEB_FETCH_MAX_BYTES=2097152
AVA_WEB_FETCH_MAX_CHARS=20000
AVA_WEB_FETCH_MAX_REDIRECTS=4
# Optional comma-separated hostname substrings to refuse outright (on top of the
# public-IP-only SSRF guard), e.g. "facebook.com,doubleclick.net".
AVA_WEB_DOMAIN_DENYLIST=
# Anonymity: route the host page-fetch through Tor (SOCKS5h) so sites see a Tor
# exit IP, never your real one. FAIL-CLOSED — if Tor is down the fetch errors
# instead of leaking over clearnet. SearXNG egresses via Tor too (searxng/run.sh).
# Set 0 to disable (not recommended). Bring the stack up with: ./searxng/run.sh
AVA_WEB_TOR=1
AVA_WEB_TOR_SOCKS=socks5h://127.0.0.1:9050

# ── Ports & upload limits ───────────────────────────────────────────────────
APP_PORT=8096
TS_PORT=8445
AVA_MAX_UPLOAD_MB=25
AVA_MAX_AUDIO_MB=25
AVA_MAX_UPLOAD_CHUNK_KB=1024
AVA_MAX_DOC_CHARS=24000
AVA_AUDIO_DECODE_TIMEOUT=30
AVA_PROXY_MAX_BYTES=33554432

# ── Agent-state snapshots (ava-snapshot.timer) ──────────────────────────────
# How many automatic snapshots to retain before pruning the oldest.
AVA_SNAPSHOT_KEEP=14
